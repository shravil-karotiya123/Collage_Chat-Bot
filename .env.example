# ==============================================================================
# Sovereign On-Premise Agentic AI Workbench - Environment Configuration
# ==============================================================================

# System Settings
PROJECT_NAME="Sovereign On-Premise Agentic AI Workbench"
ENVIRONMENT="development"
DEBUG=true

# Ollama / Local Inference Server Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_TIMEOUT=120.0
MAX_CONCURRENT_MODELS=1

# Hardware Allocation Constraints (RTX 5050 GPU / 16 GB RAM Workstation)
MAX_VRAM_USAGE_MB=7168
MAX_RAM_USAGE_MB=12288
GPU_DEVICE_ID=0

# Default Loaded Model Tags
DEFAULT_ROUTER_MODEL="qwen2.5-coder:7b"
DEFAULT_VISION_MODEL="llava:7b"
DEFAULT_RAG_MODEL="llama3:8b"
DEFAULT_GENERAL_MODEL="llama3:8b"

# Path Configuration
LOG_DIR="logs"
DOCUMENT_DIR="documents"
OUTPUT_DIR="outputs"
DATABASE_DIR="database"
VECTOR_STORE_DIR="vector_store"
CACHE_DIR="cache"
DOWNLOAD_DIR="downloads"

# Logging Settings
LOG_LEVEL="INFO"
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
